# Darukaa.Earth Environment Variables Example
# Do NOT put real secrets in this file.

# --- Frontend Variables ---
# Prefix with VITE_ to expose to the frontend
VITE_API_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# --- Backend Variables ---
DATABASE_URL=postgresql://localhost/darukaa
JWT_SECRET=your_jwt_secret_here
